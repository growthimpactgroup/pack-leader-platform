# One login per role (used on the /login page). The approver (Grace) has a username only, no password. Set these in Vercel (Project → Settings → Environment Variables).
OPERATOR_USER=
OPERATOR_PASSWORD=
OPERATOR_NAME=Frances
APPROVER_USER=
APPROVER_NAME=Grace
REVIEWER_USER=
REVIEWER_PASSWORD=
REVIEWER_NAME="Review Agent"

# Supabase Postgres (leave empty locally to use data/db.json)
DATABASE_URL=
DATABASE_CA_CERT=

# Email (Resend). Demo mode sends every email to DEMO_RECIPIENT only.
RESEND_API_KEY=
EMAIL_FROM="The Pack Leader <onboarding@resend.dev>"
APP_URL=https://pack-leader-platform.vercel.app
DEMO_MODE=true
DEMO_RECIPIENT=
# Real recipients once DEMO_MODE=false
OPERATOR_EMAIL=
APPROVER_EMAIL=
REVIEWER_EMAIL=

# Daily 8:00 pm PH schedule email (Vercel Cron, vercel.json). Any long random string.
CRON_SECRET=
